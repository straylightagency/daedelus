APP_NAME="Daedelus"
APP_ENV=development
APP_KEY=base64:kzBHCh0KocO41jbe4+IfP9PWgna+BDLI55I+U1qZkNQ=
APP_DEBUG=true
APP_URL=http://daedelus.local.host

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
